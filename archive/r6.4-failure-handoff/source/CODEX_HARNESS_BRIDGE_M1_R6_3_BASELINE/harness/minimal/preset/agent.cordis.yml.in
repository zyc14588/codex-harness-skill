# Managed by Codex-Harness Bridge. Rendered at installation time.
- id: persona
  name: '@deepseek-ai/dsh-persona'
  config:
    text: You are a helpful software engineer assistant. Follow the complete task contract exactly. Use only the assigned write lease. Invoke model-visible tools directly; never print DSML/XML or Markdown shell blocks as a substitute for a tool call. Verify required files exist before claiming completion. Do not stage, commit, merge, push, or broaden scope. Request optional bridge capabilities only when the task genuinely requires them.
    complete: true
    includeRuntimeContext: false

- id: native-tool-presentation
  name: '@deepseek-ai/dsh-agent-tool-presentation'
  config:
    mode: native

- id: persistent-shell
  name: cordis:group
  group: true
  isolate:
    terminals: true
  config:
    - id: pty
      name: '@deepseek-ai/dsh-terminal'

    - id: terminal-bash
      name: '@deepseek-ai/dsh-terminal-bash'
      disabled: !!js process.platform === 'win32'
      config:
        timeoutMs: 300000

    - id: persistent-bash
      name: '@deepseek-ai/dsh-tool-bash-persistent'
      disabled: !!js process.platform === 'win32'
      config:
        timeoutMs: 300000
        description: |-
          Run bounded commands in the task workspace. Do not use the network. Do not stage or commit Git changes. Avoid large output. Long-lived processes must run in the background.

    - id: terminal-pwsh
      name: '@deepseek-ai/dsh-terminal-bash'
      disabled: !!js process.platform !== 'win32'
      config:
        shellDialect: pwsh
        timeoutMs: 300000

    - id: persistent-pwsh
      name: '@deepseek-ai/dsh-tool-pwsh-persistent'
      disabled: !!js process.platform !== 'win32'
      config:
        timeoutMs: 300000
        description: |-
          Run bounded PowerShell commands in the task workspace. Do not use the network. Do not stage or commit Git changes. Avoid large output.

- id: filesystem
  name: cordis:group
  group: true
  isolate:
    fs: true
  config:
    - id: fs-local
      name: '@deepseek-ai/dsh-fs-local'
      config:
        cwd: !!js process.env.DSH_CWD ?? process.cwd()

    - id: str-replace-editor
      name: '@deepseek-ai/dsh-tool-str-replace-editor'
      config:
        maxOutputChars: 16000

- id: bridge-progressive-tools
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: bridge
    transport: stdio
    command: __NODE_BINARY_JSON__
    args: [__MINIMAL_SERVER_JSON__]
    env:
      CODEX_HARNESS_CONFIG: !!js process.env.CODEX_HARNESS_CONFIG
      CODEX_HARNESS_TASK_ID: !!js process.env.CODEX_HARNESS_TASK_ID
    toolCallTimeoutMs: 120000
    failOnStartupError: true
    reconnect:
      enabled: false
