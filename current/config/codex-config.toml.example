# The installer normally uses `codex mcp add`; this is the equivalent manual form.
[mcp_servers.codex_harness]
command = "node"
args = ["/ABSOLUTE/PATH/CODEX_HARNESS_BRIDGE_M1_R6_4/bridge/dist/index.js"]
startup_timeout_sec = 30
tool_timeout_sec = 7200
required = true

[mcp_servers.codex_harness.env]
CODEX_HARNESS_CONFIG = "/home/zyc14588/.config/codex-harness-bridge/config.json"
