{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-harness-bridge/v7/config.schema.json",
  "title": "Codex-Harness Bridge Configuration v7",
  "description": "Configuration for adaptive split memory, parallel minimal Harness execution, token-only budget gates, monitoring, and controlled llama.cpp routing.",
  "type": "object",
  "$defs": {
    "budget": {
      "type": "object",
      "description": "Only maxInputTokens and maxOutputTokens are execution budget gates. API-call and currency fields are reference/alert thresholds.",
      "required": [
        "gatePolicy",
        "ceilingPolicy",
        "enforcement",
        "maxApiCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxCostCny",
        "maxCostUsd"
      ],
      "properties": {
        "gatePolicy": {
          "const": "input_output_tokens"
        },
        "ceilingPolicy": {
          "enum": [
            "operator_bounded",
            "unbounded"
          ]
        },
        "enforcement": {
          "const": "hard"
        },
        "maxApiCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Reference threshold only."
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000,
          "description": "Hard cumulative input-token gate."
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000,
          "description": "Hard cumulative output-token gate."
        },
        "maxCostCny": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "description": "CNY reference threshold only."
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "description": "Hidden compatibility/reference threshold only."
        }
      },
      "additionalProperties": false
    },
    "ownerResourceProfiles": {
      "type": "object",
      "required": [
        "local_or_flash_trivial_small",
        "flash_medium",
        "pro_large",
        "authoritative_verification"
      ],
      "properties": {
        "local_or_flash_trivial_small": {
          "const": {
            "memoryMaxBytes": 2147483648,
            "cpuQuotaPercent": 100,
            "tasksMax": 128,
            "ioWeight": 100,
            "worktreeMaxBytes": 2147483648,
            "rlimitNoFile": 2048,
            "rlimitNproc": 2048,
            "rlimitFsizeBytes": 536870912,
            "commandTimeoutSeconds": 900
          }
        },
        "flash_medium": {
          "const": {
            "memoryMaxBytes": 4294967296,
            "cpuQuotaPercent": 200,
            "tasksMax": 256,
            "ioWeight": 100,
            "worktreeMaxBytes": 4294967296,
            "rlimitNoFile": 4096,
            "rlimitNproc": 4096,
            "rlimitFsizeBytes": 1073741824,
            "commandTimeoutSeconds": 1800
          }
        },
        "pro_large": {
          "const": {
            "memoryMaxBytes": 8589934592,
            "cpuQuotaPercent": 400,
            "tasksMax": 512,
            "ioWeight": 100,
            "worktreeMaxBytes": 8589934592,
            "rlimitNoFile": 8192,
            "rlimitNproc": 8192,
            "rlimitFsizeBytes": 2147483648,
            "commandTimeoutSeconds": 3600
          }
        },
        "authoritative_verification": {
          "const": {
            "memoryMaxBytes": 4294967296,
            "cpuQuotaPercent": 200,
            "tasksMax": 256,
            "ioWeight": 100,
            "worktreeMaxBytes": 4294967296,
            "rlimitNoFile": 4096,
            "rlimitNproc": 4096,
            "rlimitFsizeBytes": 1073741824,
            "commandTimeoutSeconds": 1800
          }
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "inputCacheHitCnyPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "inputCacheMissCnyPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputCnyPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "inputCacheHitUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "inputCacheMissUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "inputCacheHitCnyPerMillion",
            "inputCacheMissCnyPerMillion",
            "outputCnyPerMillion"
          ]
        },
        {
          "required": [
            "inputCacheHitUsdPerMillion",
            "inputCacheMissUsdPerMillion",
            "outputUsdPerMillion"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "harnessRoot",
    "harnessProfile",
    "harnessMinimalProfile",
    "stateRoot",
    "allowedRepoRoots",
    "passEnvironment",
    "defaultRuntimeSeconds",
    "maxRuntimeSeconds",
    "logTailChars",
    "enforceHarnessPin",
    "enforceHarnessBuildHash",
    "requireCleanRepoAtStart",
    "allowDirtyHarnessCheckout",
    "controller",
    "monitor",
    "provider",
    "harnessIsolation",
    "llamaCpp"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "installation": {
      "type": "object",
      "required": ["runtimeRoot", "implementationCommit", "candidatePath"],
      "properties": {
        "runtimeRoot": { "type": "string", "pattern": "^/" },
        "implementationCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "candidatePath": { "type": "string", "pattern": "^0\\.6\\.6-candidate-[0-9a-f]{12}$" }
      },
      "additionalProperties": false
    },
    "harnessRoot": {
      "type": "string",
      "minLength": 1
    },
    "harnessCli": {
      "type": "string",
      "minLength": 1
    },
    "harnessBuildRoot": {
      "type": "string",
      "minLength": 1
    },
    "harnessProfile": {
      "type": "string",
      "minLength": 1
    },
    "harnessMinimalProfile": {
      "type": "string",
      "minLength": 1
    },
    "dshHome": {
      "type": "string",
      "minLength": 1
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1
    },
    "allowedRepoRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "passEnvironment": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PATH",
          "LANG",
          "LC_ALL",
          "TERM",
          "COLORTERM",
          "NO_COLOR",
          "NODE_EXTRA_CA_CERTS",
          "SSL_CERT_FILE"
        ]
      }
    },
    "defaultRuntimeSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "maxRuntimeSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "logTailChars": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 1000000
    },
    "pinnedHarnessCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pinnedHarnessBuildSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enforceHarnessPin": {
      "type": "boolean"
    },
    "enforceHarnessBuildHash": {
      "type": "boolean"
    },
    "requireCleanRepoAtStart": {
      "type": "boolean"
    },
    "allowDirtyHarnessCheckout": {
      "type": "boolean"
    },
    "controller": {
      "type": "object",
      "required": [
        "requirePlan",
        "maxLeavesPerPlan",
        "maxHarnessWriteLeases",
        "maxHarnessContextFiles",
        "maxHarnessAcceptanceCriteria",
        "maxHarnessObjectiveChars",
        "maxConcurrentHarnessGlobal",
        "maxConcurrentHarnessPerRepo",
        "preferMinimalHarness",
        "defaultHarnessBudget",
        "maximumHarnessBudget",
        "defaultProComplexBudget",
        "splitMemory"
      ],
      "properties": {
        "requirePlan": {
          "const": true
        },
        "maxLeavesPerPlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxHarnessWriteLeases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxHarnessContextFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maxHarnessAcceptanceCriteria": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxHarnessObjectiveChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxConcurrentHarnessGlobal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxConcurrentHarnessPerRepo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "preferMinimalHarness": {
          "type": "boolean"
        },
        "defaultHarnessBudget": {
          "$ref": "#/$defs/budget"
        },
        "maximumHarnessBudget": {
          "$ref": "#/$defs/budget"
        },
        "defaultProComplexBudget": {
          "$ref": "#/$defs/budget"
        },
        "splitMemory": {
          "type": "object",
          "required": [
            "enabled",
            "minSamplesForEnforcement",
            "maxEventsPerProfile",
            "minimumLeafScale",
            "maximumLeafScale",
            "anomalyPenalty",
            "successGrowth",
            "tokenSafetyFactor"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minSamplesForEnforcement": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxEventsPerProfile": {
              "type": "integer",
              "minimum": 4,
              "maximum": 10000
            },
            "minimumLeafScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximumLeafScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "anomalyPenalty": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "successGrowth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tokenSafetyFactor": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "monitor": {
      "type": "object",
      "required": [
        "enabled",
        "host",
        "port",
        "autoStart",
        "charsPerEstimatedToken",
        "pricingAsOf",
        "pricing",
        "currency",
        "operatorAuthAudit"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "enum": [
            "127.0.0.1",
            "localhost",
            "::1"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "autoStart": {
          "type": "boolean"
        },
        "charsPerEstimatedToken": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pricingAsOf": {
          "type": "string",
          "minLength": 1
        },
        "pricing": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/pricing"
          }
        },
        "currency": {
          "type": "object",
          "required": [
            "primary",
            "showUsd",
            "usdToCnyRate",
            "fxAsOf",
            "fxSource"
          ],
          "properties": {
            "primary": {
              "const": "CNY"
            },
            "showUsd": {
              "type": "boolean"
            },
            "usdToCnyRate": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "fxAsOf": {
              "type": "string",
              "minLength": 1
            },
            "fxSource": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "operatorAuthAudit": {
          "type": "object",
          "required": [
            "maxBytes",
            "maxFiles",
            "retentionDays",
            "blockedSummaryIntervalSeconds"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 104857600
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "blockedSummaryIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "baseUrl",
        "apiKeyFile"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^(https://|http://(127\\.0\\.0\\.1|localhost|\\[?::1\\]?)(:[0-9]+)?(/|$))"
        },
        "apiKeyFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "harnessIsolation": {
      "type": "object",
      "required": [
        "bubblewrapBinary",
        "bubblewrapSha256",
        "relayPort",
        "rejectEnvFiles",
        "resourceProfile",
        "resourceProfiles"
      ],
      "properties": {
        "bubblewrapBinary": {
          "type": "string",
          "pattern": "^/"
        },
        "bubblewrapSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "relayPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "rejectEnvFiles": {
          "const": true
        },
        "resourceProfile": {
          "type": "object",
          "required": [
            "enforcement",
            "systemdRunBinary",
            "systemdRunSha256",
            "prlimitBinary",
            "prlimitSha256",
            "memoryMaxBytes",
            "cpuQuotaPercent",
            "tasksMax",
            "ioWeight",
            "worktreeMaxBytes",
            "rlimitNoFile",
            "rlimitNproc",
            "rlimitFsizeBytes",
            "commandTimeoutSeconds"
          ],
          "properties": {
            "enforcement": {
              "enum": ["required", "audit_only"]
            },
            "systemdRunBinary": {
              "type": "string",
              "pattern": "^/"
            },
            "systemdRunSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "prlimitBinary": {
              "type": "string",
              "pattern": "^/"
            },
            "prlimitSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "memoryMaxBytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 1099511627776
            },
            "cpuQuotaPercent": {
              "type": "integer",
              "minimum": 10,
              "maximum": 800
            },
            "tasksMax": {
              "type": "integer",
              "minimum": 16,
              "maximum": 32768
            },
            "ioWeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "worktreeMaxBytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 1099511627776
            },
            "rlimitNoFile": {
              "type": "integer",
              "minimum": 64,
              "maximum": 1048576
            },
            "rlimitNproc": {
              "type": "integer",
              "minimum": 16,
              "maximum": 32768
            },
            "rlimitFsizeBytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 1099511627776
            },
            "commandTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7200
            }
          },
          "additionalProperties": false
        },
        "resourceProfiles": {
          "$ref": "#/$defs/ownerResourceProfiles"
        }
      },
      "additionalProperties": false
    },
    "llamaCpp": {
      "type": "object",
      "required": [
        "enabled",
        "autoRouteSimpleLeaves",
        "mode",
        "baseUrl",
        "apiKeyEnv",
        "model",
        "serverBinary",
        "serverArgs",
        "serverAutoStart",
        "serverStartupTimeoutSeconds",
        "cliBinary",
        "cliArgs",
        "requestTimeoutSeconds",
        "maxFilesPerTask",
        "maxContextFiles",
        "maxContextBytes",
        "maxFileBytes",
        "maxOutputTokens",
        "fallbackEnabled",
        "fallbackModel"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "autoRouteSimpleLeaves": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "external_server",
            "managed_server",
            "cli"
          ]
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[?::1\\]?)(:[0-9]+)?/"
        },
        "apiKeyEnv": {
          "const": "LLAMA_CPP_API_KEY"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "serverBinary": {
          "type": "string",
          "minLength": 1
        },
        "serverBinarySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serverArgs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "serverAutoStart": {
          "type": "boolean"
        },
        "serverStartupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "cliBinary": {
          "type": "string",
          "minLength": 1
        },
        "cliBinarySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cliArgs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          },
          "allOf": [
            {
              "contains": {
                "pattern": "\\{\\{PROMPT_FILE\\}\\}"
              }
            },
            {
              "not": {
                "contains": {
                  "pattern": "\\{\\{PROMPT\\}\\}"
                }
              }
            }
          ]
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "maxFilesPerTask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxContextFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxContextBytes": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "fallbackEnabled": {
          "type": "boolean"
        },
        "fallbackModel": {
          "const": "deepseek-v4-flash"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enforceHarnessPin": {
            "const": true
          }
        },
        "required": [
          "enforceHarnessPin"
        ]
      },
      "then": {
        "required": [
          "pinnedHarnessCommit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "enforceHarnessBuildHash": {
            "const": true
          }
        },
        "required": [
          "enforceHarnessBuildHash"
        ]
      },
      "then": {
        "required": [
          "pinnedHarnessBuildSha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "llamaCpp": {
            "properties": {
              "enabled": { "const": true },
              "mode": { "const": "managed_server" }
            },
            "required": ["enabled", "mode"]
          }
        },
        "required": ["llamaCpp"]
      },
      "then": {
        "properties": {
          "llamaCpp": {
            "properties": {
              "serverBinary": { "pattern": "^/" }
            },
            "required": ["serverBinarySha256"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llamaCpp": {
            "properties": {
              "enabled": { "const": true },
              "mode": { "const": "cli" }
            },
            "required": ["enabled", "mode"]
          }
        },
        "required": ["llamaCpp"]
      },
      "then": {
        "properties": {
          "llamaCpp": {
            "properties": {
              "cliBinary": { "pattern": "^/" }
            },
            "required": ["cliBinarySha256"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
